.DS_Store
__pycache__/
.pytest_cache/
.ruff_cache/
.nuke-ide/
**/node_modules
**/.browser_modules
**/dist
applications/*/lib/
extensions/*/lib/
!extensions/*/python/**/lib/
**/src-gen
**/gen-webpack.config.js
**/gen-webpack.node.config.js
/plugins
**/tsconfig.tsbuildinfo
*.log
**/.electron-cache

# Generated files
resources/preload.html
coverage.xml
.coverage
.cache/

# nuke-cad document build sidecars (tessellation cache + STEP exports written
# beside the source document on build; they regenerate — only the small
# `.nuke-cad` sources are fixtures; large reference STEPs stay
# developer-local via env vars and are never committed)
*.tess.json
*.nuke-cache.zip
*.step
*.step.key

# nuke-cad example-project JSON is generated from the canonical e2e .nuke-cad
# fixtures by scripts/copy-cad-samples.js during the build; do not commit copies
extensions/nuke-cad/src/common/samples/*.json

# Docker compose workspace volume
applications/docker/workspace/

# Playwright GUI smoke test artifacts
test-results/
tests/ui/fixtures/*.smoke.nuke-cad
# CSG Builder smoke projects are staged at runtime and removed afterwards;
# generated XML must never dirty the tree when a test fails mid-run.
tests/ui/fixtures/csg-smoke/**/geometry.xml
tests/ui/fixtures/csg-smoke/**/materials.xml
playwright-report/
