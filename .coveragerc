# Coverage configuration for the extension Python backends.
#
# Tiered coverage policy (see root AGENTS.md):
#   - Logic layer (parsers, converters, services, command handlers) is measured
#     and ratcheted — the threshold in `yarn test:python:cov` may only go UP.
#   - Rendering layer (the headless VTK converter seam) is excluded here:
#     it is exercised by the error-path contract tests and the docker smoke
#     test, not by unit tests (unit-testing VTK into meaninglessness).

[run]
source =
    extensions/nuke-visualizer/python
    extensions/openmc-studio/python
    extensions/nuke-cad/python
    # nuke-cad's OCC/gmsh/pymoab-bound pipeline modules (geometry_service,
    # dagmc_export, mesh_service, fem_service, foam_service, ocp_compat) stay
    # out of the ratchet via `omit` below: they are only exercised in the
    # full-dependency profile (docker in-image pytest step, NUKE_TEST_PYTHON)
    # and including them would drag the total below the gate.

omit =
    # headless VTK converter seam and plugin registration glue (covered by
    # the error-path contract tests and the docker converter smoke test,
    # not by unit tests)
    extensions/nuke-visualizer/python/plugins/base/commands/serve.py
    extensions/nuke-visualizer/python/plugins/base/lib/dagmc_viz.py
    extensions/nuke-visualizer/python/plugins/base/plugin.py
    extensions/nuke-visualizer/python/plugins/openmc/plugin.py
    extensions/nuke-visualizer/python/plugins/openmc/commands/tally_viz.py
    extensions/nuke-visualizer/python/plugins/openmc/commands/xs_plot.py
    extensions/nuke-visualizer/python/plugins/openmc/lib/geometry_viz.py
    extensions/nuke-visualizer/python/plugins/openmc/lib/reader.py
    extensions/nuke-visualizer/python/plugins/openmc/lib/slice_viz.py
    # OCC/gmsh/pymoab-bound nuke-cad pipeline modules — full-profile-only,
    # exercised by the docker in-image pytest step (see note above)
    extensions/nuke-cad/python/geometry_service.py
    extensions/nuke-cad/python/dagmc_export.py
    extensions/nuke-cad/python/mesh_service.py
    extensions/nuke-cad/python/fem_service.py
    extensions/nuke-cad/python/foam_service.py
    extensions/nuke-cad/python/ocp_compat.py
    extensions/nuke-cad/python/reference_resolver.py

[report]
show_missing = true
skip_covered = true
exclude_also =
    # Don't complain about defensive re-runs
    if __name__ == .__main__.:
    # Don't complain about abstract methods
    @(abc\.)?abstractmethod

# Ratchet: the logic-layer threshold may only go UP. Bump it whenever the
# measured baseline improves; never lower it.
fail_under = 94
