def sketch_Block_profile_sketch_a():
    with bd.BuildSketch(datum_XY_datum_xy) as sk:
        with bd.BuildLine():
            bd.Line((0, 0), (2, 0))
            bd.Line((2, 0), (2, 1))
            bd.Line((2, 1), (0, 1))
            bd.Line((0, 1), (0, 0))
        bd.make_face()
        # External geometry references (projected construction geometry)
