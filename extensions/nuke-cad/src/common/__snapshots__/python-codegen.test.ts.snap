body_Block = body_Block + bd.extrude(sketch_Block_profile_sketch_a(), amount=2, dir=(0, 0, 1)) if body_Block is not None else bd.extrude(sketch_Block_profile_sketch_a(), amount=2, dir=(0, 0, 1))  # Base block
body_Pin = body_Pin + bd.extrude(sketch_Pin_profile_sketch_b(), amount=2, dir=(0, 0, 1)) if body_Pin is not None else bd.extrude(sketch_Pin_profile_sketch_b(), amount=2, dir=(0, 0, 1))  # Pin
