{
  "private": true,
  "name": "nuke-cad",
  "version": "0.2.0",
  "description": "Parametric CAD / meshing extension for NukeIDE",
  "license": "BSD-2-Clause",
  "keywords": [
    "theia-extension",
    "nukeide",
    "cad",
    "parametric",
    "build123d",
    "cadquery",
    "ocp",
    "meshing",
    "fem",
    "planegcs"
  ],
  "files": [
    "lib",
    "src",
    "python"
  ],
  "dependencies": {
    "@salusoft89/planegcs": "1.3.0",
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/workspace": "1.76.0",
    "nuke-core": "0.2.0",
    "nuke-essentials": "0.2.0",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@types/three": "^0.167.1",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf --glob lib *.tsbuildinfo",
    "build": "yarn run copy-samples && tsc && yarn run copy-css",
    "copy-samples": "node ../../scripts/copy-cad-samples.js",
    "copy-css": "node ../../scripts/copy-css.js",
    "watch": "yarn run copy-samples && tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/nuke-cad-frontend-module",
      "backend": "lib/node/nuke-cad-backend-module"
    }
  ]
}
