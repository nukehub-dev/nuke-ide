{
  "private": true,
  "name": "nuke-visualizer",
  "version": "0.2.0",
  "description": "Advanced 3D visualization for nuclear computational data in NukeIDE",
  "license": "BSD-2-Clause",
  "keywords": [
    "theia-extension",
    "nuclear",
    "visualization",
    "dagmc",
    "h5m",
    "vtk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nukehub-dev/nuke-ide.git"
  },
  "bugs": {
    "url": "https://github.com/nukehub-dev/nuke-ide/issues"
  },
  "files": [
    "lib",
    "src",
    "python",
    "resources",
    "css"
  ],
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/workspace": "1.76.0",
    "fflate": "^0.8.3",
    "http-proxy": "^1.18.1",
    "nuke-essentials": "0.2.0",
    "plotly.js-dist-min": "^3.7.0",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/plotly.js": "^3.0.15",
    "@types/three": "^0.167.1",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf --glob lib *.tsbuildinfo",
    "build": "tsc && yarn run copy-css",
    "copy-css": "node ../../scripts/copy-css.js",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/visualizer-frontend-module",
      "backend": "lib/node/visualizer-backend-module"
    }
  ]
}
